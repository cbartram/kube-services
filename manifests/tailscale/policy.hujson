// Tailnet policy file. This is not applied by ArgoCD, paste it into the Tailscale
// admin console under Access Controls, or sync it with the GitOps action.
{
    "groups": {
        "group:friends": ["friend1@gmail.com", "friend2@gmail.com", "cbartram3@gmail.com"],
    },

    "tagOwners": {
        // These tags scope traffic to an individual game server so friends do not
        // get access to the rest of the tailnet.
        "tag:valheim":      ["tag:k8s-operator"],
        "tag:vrising":      ["tag:k8s-operator"],
        "tag:windrose":     ["tag:k8s-operator"],
        "tag:engineering":  [],
        "tag:k8s-operator": [],
        "tag:k8s":          ["tag:k8s-operator"],
    },

    "grants": [
        // {"src": ["*"], "dst": ["*"], "ip": ["*"]},
        {
            "src": ["tag:engineering"],
            "dst": ["tag:k8s-operator"],
            "ip":  ["tcp:443", "tcp:80"],
        },
        {
            "src": ["group:friends"],
            "dst": ["tag:valheim"],
            "ip": [
                "udp:2456",
                "udp:2457",
                "udp:2458",
                "tcp:2456",
                "tcp:2457",
                "tcp:2458",
                "tcp:8080",
                "udp:8080",
            ],
        },
        {
            "src": ["group:friends"],
            "dst": ["tag:vrising"],
            "ip": [
                "udp:9876",
                "udp:9877",
                "tcp:9876",
                "tcp:9877",
            ],
        },
        {
            // Windrose direct connection needs both TCP and UDP on the game port.
            // 8780 is the Windrose+ dashboard and is only listening when
            // windrosePlus.enabled is true in the helm chart.
            "src": ["group:friends"],
            "dst": ["tag:windrose"],
            "ip": [
                "tcp:7777",
                "udp:7777",
                "tcp:8780",
            ],
        },
        {
            "src": ["cbartram3@gmail.com"],
            "dst": ["*"],
            "ip":  ["*"],
        },
    ],

    "autoApprovers": {
        "services": {"svc:*": ["tag:k8s", "tag:valheim", "tag:vrising", "tag:windrose"]},
    },

    // Define users and devices that can use Tailscale SSH.
    "ssh": [
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
    ],

    "tests": [
        // Verify admin access to the Kubernetes API
        {
            "src":    "cbartram3@gmail.com",
            "accept": ["tag:k8s:443"],
        },
        // Verify admin access to Valheim
        {
            "src": "cbartram3@gmail.com",
            "accept": [
                "tag:valheim:2456",
                "tag:valheim:2457",
                "tag:valheim:2458",
                "tag:valheim:8080",
            ],
        },
        // Verify admin access to Windrose
        {
            "src":    "cbartram3@gmail.com",
            "accept": ["tag:windrose:7777", "tag:windrose:8780"],
        },
        // Verify FRIENDS have access to Valheim (checking one is sufficient)
        {
            "src":    "friend1@gmail.com",
            "accept": ["tag:valheim:2456", "tag:valheim:2457", "tag:valheim:8080"],
        },
        {
            "src":    "friend1@gmail.com",
            "accept": ["tag:vrising:9876", "tag:vrising:9877"],
        },
        // Verify FRIENDS can reach the Windrose game port and dashboard
        {
            "src":    "friend1@gmail.com",
            "accept": ["tag:windrose:7777", "tag:windrose:8780"],
        },
        // Verify FRIENDS cannot reach other ports on the Windrose node, so a
        // misconfigured container port is not silently exposed to the group
        {
            "src":  "friend2@gmail.com",
            "deny": ["tag:windrose:22", "tag:windrose:80", "tag:windrose:443"],
        },
        // Verify FRIENDS are DENIED access to the Kubernetes API
        {
            "src":  "friend1@gmail.com",
            "deny": ["tag:k8s:443", "tag:k8s:80"],
        },
        // Verify FRIENDS are DENIED access to the operator itself
        {
            "src":  "friend1@gmail.com",
            "deny": ["tag:k8s-operator:443", "tag:k8s-operator:80"],
        },
        // Verify FRIENDS are DENIED access to random other engineering tags
        {
            "src":  "friend1@gmail.com",
            "deny": ["tag:engineering:443"],
        },
        // Verify the Windrose grant did not leak into the other game servers'
        // tags or vice versa
        {
            "src":  "friend1@gmail.com",
            "deny": ["tag:valheim:7777", "tag:vrising:7777"],
        },
    ],
}
